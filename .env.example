# Copy to .env for local testing of GitHub mode. Real values go in Vercel Project Settings. Never commit .env.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Recipe submission form (/submit): a server route opens a draft pull request with the recipe.
# Token: fine-grained personal access token limited to this repo, with Contents (read/write) and Pull requests (read/write).
SUBMISSIONS_GITHUB_TOKEN=
SUBMISSIONS_GITHUB_REPO=barakgotesman/hotburekas
# Optional, defaults to main
SUBMISSIONS_BASE_BRANCH=main
