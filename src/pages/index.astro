---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import TiltCard from '../components/TiltCard.astro';
import Sticker from '../components/Sticker.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RecipeCard from '../components/RecipeCard.astro';
import KashrutBadge from '../components/KashrutBadge.astro';
import HeatBadge from '../components/HeatBadge.astro';
import Button from '../components/Button.astro';
import { getCategories, getPublishedRecipes, getSettings } from '../lib/reader';
import { resolveImage } from '../lib/images';
import { formatMinutes } from '../lib/format';

const [settings, categories, recipes] = await Promise.all([getSettings(), getCategories(), getPublishedRecipes()]);
const heroImage = resolveImage(settings.heroImage);
// Recipe of the week: the one picked in settings, falling back to the newest recipe.
const featured = recipes.find((r) => r.slug === settings.featuredRecipe) ?? recipes[0];
const trending = recipes.slice(0, 4);
---

<BaseLayout
  title="מתכוני בורקס ביתיים"
  description="מחפשים מתכוני בורקס ביתיים? באתר בורקס לוהט תמצאו כמויות מדויקות, זמני הכנה ואפייה והוראות ברורות שלב אחר שלב. בחרו מתכון והתחילו להכין בבית."
>
  {/* 1. Ticker: full-bleed ink strip, the news scrolls past like a shop-window sign.
      The track holds two identical copies and animates by 50%, so the loop is seamless. */}
  {
    settings.tickerText && (
      <div class="overflow-hidden border-b-2 border-ink bg-inverse-surface text-primary-container">
        <p class="sr-only">{settings.tickerText}</p>
        <div class="flex w-max animate-marquee items-center py-2" aria-hidden="true">
          {[0, 1].map(() => (
            <div class="flex shrink-0 items-center">
              {[0, 1, 2, 3].map(() => (
                <span class="flex items-center gap-4 pe-4 text-label-lg">
                  <Icon name="sesame" class="size-4 text-secondary-container" />
                  {settings.tickerText}
                  <Icon name="flame" class="size-4 text-secondary-container" />
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>
    )
  }

  <Container class="space-y-14 pt-8 lg:space-y-20 lg:pt-12">
    {/* 2. Hero poster: giant stamped headline, tomato highlight label, tilted photo */}
    <section class="relative md:grid md:grid-cols-[1.05fr_1fr] md:items-center md:gap-10 lg:gap-14">
      {
        settings.heroStamp && (
          <div class="absolute -top-3 end-0 z-20 flex size-24 rotate-12 flex-col items-center justify-center gap-0.5 rounded-full border-2 border-ink bg-primary-container p-2 text-center text-on-primary-container shadow-card outline-2 -outline-offset-[7px] outline-dashed outline-ink md:-top-6 md:size-28">
            <Icon name="material-symbols:local-fire-department" class="size-5 text-secondary" aria-hidden="true" />
            <span class="font-display text-label-md leading-tight">{settings.heroStamp}</span>
          </div>
        )
      }
      <div>
        <h1 class="pe-20 text-[clamp(3rem,13.5vw,4.5rem)] leading-[0.95] md:pe-0 md:text-[clamp(2.75rem,6.5vw,7rem)]">
          {settings.heroTitle}
          <br />
          <span class="mt-3 inline-block -rotate-1 whitespace-nowrap rounded-md border-2 border-ink bg-secondary px-3 pb-1 text-[0.8em] text-on-secondary shadow-card">
            {settings.heroHighlight}
          </span>
        </h1>
        <p class="mt-6 max-w-md text-lg font-medium text-on-surface-variant">{settings.heroText}</p>

        <form action="/recipes/" method="get" role="search" class="relative mt-6 flex items-center">
          <Icon name="material-symbols:skillet-outline" class="pointer-events-none absolute start-3 size-5 text-on-surface" aria-hidden="true" />
          <input
            type="search"
            name="q"
            aria-label="חיפוש מתכון"
            placeholder="מה בא לכם להכין היום?"
            class="min-h-14 w-full rounded-xl border-2 border-ink bg-surface-container-lowest py-3 ps-10 pe-28 text-base shadow-card placeholder:text-on-surface-variant/70 focus:outline-none focus-visible:bg-primary-fixed"
          />
          <button
            type="submit"
            class="absolute end-2 flex min-h-10 items-center gap-1 rounded-lg border-2 border-ink bg-secondary px-3 text-label-md text-on-secondary transition hover:bg-primary-container hover:text-on-primary-container active:scale-95"
          >
            חיפוש
            <Icon name="material-symbols:arrow-back" class="size-4" aria-hidden="true" />
          </button>
        </form>
      </div>

      {
        heroImage && (
          <div class="relative mt-10 rotate-1 rounded-2xl border-2 border-ink bg-surface-container-lowest p-2 shadow-card md:mt-0">
            <Picture
              src={heroImage}
              alt={settings.heroImageAlt ?? ''}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              formats={['avif', 'webp']}
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/3] w-full rounded-lg border-2 border-ink object-cover"
            />
            <Sticker tone="paper" class="absolute -bottom-3 start-4 z-10 -rotate-3 text-label-md">
              <Icon name="material-symbols:air" class="size-4 text-secondary" aria-hidden="true" />
              הוראות מפורטות לכל שלב
            </Sticker>
          </div>
        )
      }
    </section>

    {/* 3. Category chips: scroll sideways on mobile, wrap on desktop */}
    <section aria-labelledby="cats-heading">
      <div class="mb-4 flex items-end justify-between px-1">
        <h2 id="cats-heading" class="text-3xl leading-none">בורקס לפי סוג</h2>
        <span class="text-label-md text-on-surface-variant">בחרו קטגוריה</span>
      </div>
      <ul class="-mx-5 flex gap-3 overflow-x-auto px-5 pb-3 pt-1 [scrollbar-width:none] lg:mx-0 lg:flex-wrap lg:px-0">
        {
          categories.map((cat, i) => (
            <li class="shrink-0">
              <a
                href={`/categories/${cat.slug}/`}
                class:list={[
                  'flex min-h-12 items-center gap-2 rounded-full border-2 border-ink px-4 py-2 text-label-lg shadow-soft transition hover:-translate-y-0.5 hover:bg-primary-container active:translate-x-[-2px] active:translate-y-[2px] active:shadow-none',
                  i === 2 ? 'bg-primary-container' : i % 2 ? 'bg-surface-container-lowest' : 'bg-surface-container-high',
                ]}
              >
                <Icon name={cat.entry.icon} class="size-5" aria-hidden="true" />
                {cat.entry.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {/* 4. Recipe of the week: a saffron "special of the day" board */}
    {
      featured && (
        <section aria-labelledby="featured-heading">
          <TiltCard class="space-y-4 bg-primary-container p-5 pt-8 lg:grid lg:grid-cols-[1fr_auto] lg:gap-x-10 lg:space-y-0 lg:p-10" index={0}>
            <Sticker tone="heat" class="absolute -top-4 start-5 z-10 text-label-md">
              <Icon name="material-symbols:award-star" class="size-4" aria-hidden="true" />
              <span id="featured-heading">מתכון השבוע</span>
            </Sticker>
            <div class="space-y-4">
              <div class="flex flex-wrap items-center gap-2">
                <KashrutBadge kashrut={featured.entry.kashrut} />
                <HeatBadge difficulty={featured.entry.difficulty} />
              </div>
              <h3 class="text-4xl leading-[1.05] lg:text-6xl">{featured.entry.title}</h3>
              <p class="text-lg font-medium text-on-primary-container/80">{featured.entry.summary}</p>
              {featured.entry.chefTip && (
                <blockquote class="flex items-start gap-2.5 rounded-xl border-2 border-ink bg-surface-container-lowest p-3">
                  <Icon name="material-symbols:format-quote" class="mt-0.5 size-6 shrink-0 text-secondary" aria-hidden="true" />
                  <p class="text-label-lg font-medium italic">״{featured.entry.chefTip}״</p>
                </blockquote>
              )}
            </div>
            <div class="space-y-4 lg:w-72 lg:self-end">
              <dl class="grid grid-cols-2 gap-2 rounded-xl border-2 border-ink bg-surface-container-lowest p-3">
                <div class="flex items-center gap-2">
                  <Icon name="material-symbols:timer-outline" class="size-9 rounded-lg border-2 border-ink bg-primary-container p-1.5" aria-hidden="true" />
                  <div>
                    <dt class="text-label-sm text-on-surface-variant">זמן בישול</dt>
                    <dd class="text-label-lg">{formatMinutes(featured.entry.cookMinutes)}</dd>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <Icon name="material-symbols:room-service-outline" class="size-9 rounded-lg border-2 border-ink bg-primary-container p-1.5" aria-hidden="true" />
                  <div>
                    <dt class="text-label-sm text-on-surface-variant">מספר מנות</dt>
                    <dd class="text-label-lg">{featured.entry.servings} מנות</dd>
                  </div>
                </div>
              </dl>
              <Button href={`/recipes/${featured.slug}/`} variant="primary" class="w-full">
                <Icon name="material-symbols:restaurant-menu" class="size-5" aria-hidden="true" />
                למתכון המלא
              </Button>
            </div>
          </TiltCard>
        </section>
      )
    }

    {/* 5. Trending */}
    <section>
      <SectionHeading title="המתכונים החדשים" icon="material-symbols:whatshot-outline" linkHref="/recipes/" linkText="לכל המתכונים" />
      <div class="grid gap-8 pt-1 sm:grid-cols-2 lg:grid-cols-4">
        {trending.map((recipe, i) => <RecipeCard recipe={recipe} index={i} />)}
      </div>
    </section>

    {/* 6. Follow banner (RSS: no accounts or newsletter backend on this site) */}
    <section class="relative -rotate-1 rounded-2xl border-2 border-ink bg-secondary p-6 text-center text-on-secondary shadow-card lg:p-10">
      <Icon name="material-symbols:bakery-dining-outline" class="mx-auto size-10 text-primary-container" aria-hidden="true" />
      <h2 class="mt-2 text-3xl leading-tight lg:text-5xl">{settings.footerText}</h2>
      <p class="mx-auto mt-2 max-w-sm text-label-lg font-medium">הישארו מעודכנים כשמתכון חדש מתפרסם באתר.</p>
      <Button href="/rss.xml" variant="crust" class="mt-5 w-full sm:w-auto">
        <Icon name="material-symbols:rss-feed" class="size-5" aria-hidden="true" />
        עקבו אחרי המתכונים
      </Button>
      <p class="mx-auto mt-4 max-w-sm text-label-lg font-medium">
        יש לכם מתכון משלכם?
        <a href="/submit/" class="underline underline-offset-2">שלחו אותו דרך הטופס באתר.</a>
      </p>
    </section>
  </Container>
</BaseLayout>
