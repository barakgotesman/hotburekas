---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import burnt from '../assets/images/site/burnt.jpg';
---

<BaseLayout title="העמוד לא נמצא" description="הבורקס נשרף... העמוד הזה הלך לפח!">
  <Container class="mx-auto max-w-xl space-y-5 text-center">
    <div class="mt-2 flex flex-col items-center">
      <p class="inline-flex items-center gap-1 rounded-full bg-surface-container-highest px-3 py-1 text-label-sm text-secondary shadow-soft">
        <Icon name="material-symbols:local-fire-department" class="size-4" aria-hidden="true" />
        אופס! קטסטרופה במאפייה (קוד שגיאה: 404)
      </p>
      <h1 class="mt-2 text-headline-xl">
        הבורקס נשרף...<br />
        <span class="text-secondary">העמוד הזה הלך לפח!</span>
      </h1>
    </div>

    {/* Burnt-pastry card with a second paper sheet peeking out underneath */}
    <div class="relative -rotate-1 px-1">
      <div class="absolute inset-0 translate-y-1 rotate-2 rounded-xl bg-surface-container" aria-hidden="true"></div>
      <div class="relative flex flex-col items-center overflow-hidden rounded-xl bg-surface-container-lowest p-4 shadow-card">
        <span class="absolute -end-3 -top-1 inline-flex rotate-12 items-center gap-1 rounded-sm bg-secondary px-4 py-1 text-label-sm text-on-secondary shadow-soft">
          לוהט מדי
          <Icon name="flame" class="size-3.5" aria-hidden="true" />
        </span>
        <Image
          src={burnt}
          alt="איור של בורקס שרוף ומפויח שבוכה על נייר אפייה חרוך"
          width={290}
          height={290}
          class="aspect-square w-full max-w-[290px] rounded-lg bg-surface-container-low object-contain p-2"
        />
        <p class="mt-3 text-on-surface-variant">
          השארנו אותו בתנור 20 דקות יותר מדי. העמוד שחיפשתם התפייח לחלוטין ונזרק לפח הזבל של המאפייה.
        </p>
        {/* Heat gauge stuck on "sizzling" */}
        <div class="mt-4 w-full rounded-lg bg-surface-container-low p-2 text-start">
          <div class="flex items-center justify-between text-label-sm font-bold text-secondary">
            <span class="flex items-center gap-1">
              <Icon name="material-symbols:thermostat" class="size-4" aria-hidden="true" />
              מד חום בתנור:
            </span>
            <span>300°C (שרוף כפחם!)</span>
          </div>
          <div class="mt-1.5 flex h-3 gap-1 overflow-hidden rounded-full bg-surface-container-highest p-0.5" aria-hidden="true">
            <div class="h-full w-1/3 rounded-full bg-primary-container opacity-60"></div>
            <div class="h-full w-1/3 rounded-full bg-secondary-container opacity-80"></div>
            <div class="h-full w-1/3 animate-pulse rounded-full bg-secondary"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-start gap-3 rounded-xl bg-tertiary-container/30 p-4 text-start shadow-soft">
      <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-tertiary text-on-tertiary">
        <Icon name="material-symbols:bakery-dining" class="size-6" aria-hidden="true" />
      </span>
      <div>
        <h2 class="text-headline-sm text-on-tertiary-container">בשורות מעולות מהמטבח!</h2>
        <p class="text-label-md">אל תדאגו, יש לנו מגש חדש, פריך וזהוב בדיוק עכשיו בתוך הטאבון.</p>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <Button href="/" variant="crust" class="w-full">
        <Icon name="material-symbols:home" class="size-5" aria-hidden="true" />
        החזירו אותי למגש הראשי
      </Button>
      <Button href="/recipes/" variant="secondary" class="w-full">
        <Icon name="material-symbols:cookie-outline" class="size-5" aria-hidden="true" />
        קחו אותי למתכונים שלא נשרפים
      </Button>
    </div>

    <form action="/recipes/" method="get" role="search" class="rounded-xl bg-surface-container-lowest p-4 text-start shadow-soft">
      <label for="not-found-search" class="mb-2 block text-label-md font-bold">או חפשו מאפה אחר כאן...</label>
      <div class="relative flex items-center">
        <input
          id="not-found-search"
          type="search"
          name="q"
          placeholder="למשל: גבינה, תרד, חציל..."
          class="min-h-12 w-full rounded-xl bg-surface-container-low py-3 ps-4 pe-14 text-base focus:bg-surface-container focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-container"
        />
        <button type="submit" aria-label="חיפוש" class="absolute end-1.5 flex size-10 items-center justify-center rounded-lg bg-secondary text-on-secondary active:scale-90">
          <Icon name="material-symbols:arrow-back" class="size-5" aria-hidden="true" />
        </button>
      </div>
    </form>

    <p class="text-label-sm text-on-surface-variant">שגיאות קורות גם לאופים הכי ותיקים. קחו נשימה עמוקה.</p>
  </Container>
</BaseLayout>
