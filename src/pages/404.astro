---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import burnt from '../assets/images/site/burnt.jpg';
---

<BaseLayout title="העמוד לא נמצא" description="העמוד שחיפשתם לא קיים או שהועבר למקום אחר.">
  <Container class="mx-auto max-w-xl space-y-5 text-center">
    <div class="mt-2 flex flex-col items-center">
      <p class="inline-flex items-center gap-1 rounded-full bg-surface-container-highest px-3 py-1 text-label-sm text-secondary border-2 border-ink shadow-soft">
        <Icon name="material-symbols:local-fire-department" class="size-4" aria-hidden="true" />
        שגיאה 404
      </p>
      <h1 class="mt-2 text-4xl leading-tight lg:text-6xl">
        העמוד לא נמצא<br />
        <span class="text-secondary">אבל המתכונים עדיין כאן</span>
      </h1>
    </div>

    {/* Illustration card with a second paper sheet peeking out underneath */}
    <div class="relative -rotate-1 px-1">
      <div class="absolute inset-0 translate-y-1 rotate-2 rounded-xl bg-surface-container" aria-hidden="true"></div>
      <div class="relative flex flex-col items-center overflow-hidden rounded-xl bg-surface-container-lowest p-4 border-2 border-ink shadow-card">
        <Image
          src={burnt}
          alt="איור של בורקס שרוף ובוכה"
          width={290}
          height={290}
          class="aspect-square w-full max-w-[290px] rounded-lg bg-surface-container-low object-contain p-2"
        />
        <p class="mt-3 text-on-surface-variant">
          ייתכן שהקישור שגוי או שהמתכון הוסר. אפשר לחזור לדף הבית או לחפש מתכון אחר.
        </p>
      </div>
    </div>

    <div class="flex items-start gap-3 rounded-xl bg-tertiary-container/30 p-4 text-start border-2 border-ink shadow-soft">
      <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-tertiary text-on-tertiary">
        <Icon name="material-symbols:bakery-dining" class="size-6" aria-hidden="true" />
      </span>
      <div>
        <h2 class="text-2xl text-on-tertiary-container">מחפשים מתכון?</h2>
        <p class="text-label-md">המתכונים באתר מחולקים לפי קטגוריות ואפשר גם לחפש לפי שם או מילוי.</p>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <Button href="/" variant="crust" class="w-full">
        <Icon name="material-symbols:home" class="size-5" aria-hidden="true" />
        לדף הבית
      </Button>
      <Button href="/recipes/" variant="secondary" class="w-full">
        <Icon name="material-symbols:cookie-outline" class="size-5" aria-hidden="true" />
        לכל המתכונים
      </Button>
    </div>

    <form action="/recipes/" method="get" role="search" class="rounded-xl bg-surface-container-lowest p-4 text-start border-2 border-ink shadow-soft">
      <label for="not-found-search" class="mb-2 block text-label-md font-bold">או חפשו מתכון:</label>
      <div class="relative flex items-center">
        <input
          id="not-found-search"
          type="search"
          name="q"
          placeholder="למשל: גבינה, תרד, חציל..."
          class="min-h-12 w-full rounded-xl bg-surface-container-low py-3 ps-4 pe-14 text-base focus:bg-surface-container focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-container"
        />
        <button type="submit" aria-label="חיפוש" class="absolute end-1.5 flex size-10 items-center justify-center rounded-lg bg-secondary text-on-secondary active:scale-90">
          <Icon name="material-symbols:arrow-back" class="size-5" aria-hidden="true" />
        </button>
      </div>
    </form>

      </Container>
</BaseLayout>
