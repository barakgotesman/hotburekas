---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { Icon } from 'astro-icon/components';
import TiltCard from '../../components/TiltCard.astro';
import { getCategories, getPublishedRecipes } from '../../lib/reader';

const [categories, recipes] = await Promise.all([getCategories(), getPublishedRecipes()]);
/** Number of published recipes in a category. */
const countIn = (slug: string) => recipes.filter((r) => r.entry.category === slug).length;
---

<BaseLayout title="קטגוריות" description="כל סוגי הבורקס לפי קטגוריות." backHref="/" innerTitle="קטגוריות">
  <Container class="space-y-6">
    <h1 class="text-headline-xl">בחרו סגנון למגש</h1>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((cat, i) => (
          <li>
            <TiltCard index={i} class="bg-surface-container-low p-5">
              <a href={`/categories/${cat.slug}/`} class="block after:absolute after:inset-0">
                <Icon name={cat.entry.icon} class="size-10 text-secondary" aria-hidden="true" />
                <h2 class="mt-2 text-headline-sm">{cat.entry.name}</h2>
                <p class="mt-1 text-on-surface-variant">{cat.entry.description}</p>
                <p class="mt-3 text-label-md font-bold text-primary">{countIn(cat.slug)} מתכונים</p>
              </a>
            </TiltCard>
          </li>
        ))
      }
    </ul>
  </Container>
</BaseLayout>
