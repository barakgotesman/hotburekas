---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import RecipeGrid from '../../components/RecipeGrid.astro';
import { getCategories, getPublishedRecipes } from '../../lib/reader';

/** One page per category, with that category's published recipes. */
export const getStaticPaths = (async () => {
  const [categories, recipes] = await Promise.all([getCategories(), getPublishedRecipes()]);
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat.entry, recipes: recipes.filter((r) => r.entry.category === cat.slug) },
  }));
}) satisfies GetStaticPaths;

const { category, recipes } = Astro.props;
---

<BaseLayout title={category.name} description={category.description} backHref="/categories/" innerTitle={category.name}>
  <Container class="space-y-6">
    <header class="rounded-2xl bg-surface-container-low p-5 shadow-card lg:p-8">
      <span class="text-5xl" aria-hidden="true">{category.emoji}</span>
      <h1 class="mt-2 text-headline-xl">{category.name}</h1>
      <p class="mt-1 text-on-surface-variant">{category.description}</p>
    </header>
    <RecipeGrid recipes={recipes} />
  </Container>
</BaseLayout>
