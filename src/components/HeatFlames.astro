---
// Heat meter as `level` (1-3) flame icons (custom SVG, src/icons/flame.svg).
import { Icon } from 'astro-icon/components';

interface Props {
  level: number;
  class?: string;
}
const { level, class: className = 'size-3.5' } = Astro.props;
---

<span class="inline-flex items-center" aria-hidden="true">
  {
    [1, 2, 3].slice(0, Math.max(level, 1)).map(() => <Icon name="flame" class={className} />)
  }
</span>
