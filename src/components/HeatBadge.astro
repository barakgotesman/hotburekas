---
import { heatInfo } from '../lib/labels';
import HeatFlames from './HeatFlames.astro';

interface Props {
  /** Recipe difficulty value (easy | medium | hard), shown as the heat meter. */
  difficulty: string;
  class?: string;
}
const { difficulty, class: className = '' } = Astro.props;
const heat = heatInfo[difficulty] ?? heatInfo.easy;
---

<span
  class:list={['inline-flex items-center gap-1 rounded-md px-2.5 py-1 text-label-sm shadow-soft', heat.classes, className]}
>
  <span>{heat.name}</span>
  <HeatFlames level={heat.level} class="size-3" />
</span>
