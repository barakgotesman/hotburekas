---
import { Icon } from 'astro-icon/components';
import Container from './Container.astro';
import Logo from './Logo.astro';

interface Props {
  siteTitle: string;
  tagline?: string;
  /** Inner pages show a back button + short title on mobile instead of the brand. */
  backHref?: string;
  innerTitle?: string;
}
const { siteTitle, tagline, backHref, innerTitle } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'ראשי' },
  { href: '/recipes/', label: 'מתכונים' },
  { href: '/categories/', label: 'קטגוריות' },
  { href: '/favorites/', label: 'מועדפים' },
  { href: '/submit/', label: 'שליחת מתכון' },
];
/** Home is active only on "/", other links match by prefix. */
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const iconBtn =
  'flex size-11 items-center justify-center rounded-xl border-2 border-ink bg-surface-container-lowest text-on-surface shadow-soft transition hover:bg-primary-container active:translate-x-[-2px] active:translate-y-[2px] active:shadow-none';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b-2 border-ink bg-surface"
  data-print-hide
>
  <Container class="flex h-16 items-center justify-between gap-3 lg:h-20">
    {/* Brand (always on desktop; on mobile only when this isn't an inner page) */}
    <a href="/" class:list={['items-center gap-2', backHref ? 'hidden lg:flex' : 'flex']}>
      <Logo siteTitle={siteTitle} tagline={tagline} />
    </a>

    {
      backHref && (
        <div class="flex min-w-0 items-center gap-2 lg:hidden">
          <a href={backHref} class={iconBtn} aria-label="חזרה">
            <Icon name="material-symbols:arrow-forward" class="size-6" aria-hidden="true" />
          </a>
          {innerTitle && <p class="truncate font-display text-xl">{innerTitle}</p>}
        </div>
      )
    }

    <nav aria-label="ניווט ראשי" class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="rounded-xl border-2 border-transparent px-4 py-2.5 text-label-lg text-on-surface transition hover:border-ink aria-[current=page]:border-ink aria-[current=page]:bg-primary-container aria-[current=page]:shadow-soft"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/recipes/" class={iconBtn} aria-label="חיפוש מתכונים">
      <Icon name="material-symbols:search" class="size-6" aria-hidden="true" />
    </a>
  </Container>
</header>
