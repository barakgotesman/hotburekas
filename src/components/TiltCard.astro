---
// Decorative card with the signature bakery tilt. Alternates by `index`; straightens on hover.
// Any extra attributes (data-*, id, ...) are passed through to the element.
interface Props {
  index?: number;
  class?: string;
  tag?: 'div' | 'article' | 'section' | 'aside';
  [attr: string]: unknown;
}
const { index = 0, class: className = '', tag: Tag = 'div', ...rest } = Astro.props;

// Full class names must appear literally so Tailwind can see them.
const tilts = ['-rotate-[0.8deg]', 'rotate-[1deg]', '-rotate-1'];
const tilt = tilts[index % tilts.length];
---

<Tag
  class:list={[
    'relative rounded-2xl shadow-card transition duration-300 hover:rotate-0 hover:shadow-card-hover',
    tilt,
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
