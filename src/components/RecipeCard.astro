---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import TiltCard from './TiltCard.astro';
import Sticker from './Sticker.astro';
import KashrutBadge from './KashrutBadge.astro';
import HeatBadge from './HeatBadge.astro';
import Button from './Button.astro';
import type { RecipeItem } from '../lib/reader';
import { resolveImage } from '../lib/images';
import { formatMinutes } from '../lib/format';
import { kashrutLabels, heatInfo } from '../lib/labels';

interface Props {
  recipe: RecipeItem;
  /** Position in the list: drives the tilt + alternating background. */
  index?: number;
  /** First card(s) above the fold load eagerly; the rest are lazy. */
  eager?: boolean;
}
const { recipe, index = 0, eager = false } = Astro.props;
const { slug, entry } = recipe;
const cover = resolveImage(entry.cover);
const totalMin = entry.prepMinutes + entry.cookMinutes;

// Plain-text blob the client-side search matches against (see src/scripts/recipe-filter.ts).
const searchText = [
  entry.title,
  entry.summary,
  ...entry.ingredients.map((i) => i.name),
  kashrutLabels[entry.kashrut],
  heatInfo[entry.difficulty]?.name,
]
  .join(' ')
  .toLowerCase();
---

<TiltCard
  tag="article"
  index={index}
  class:list={[
    'recipe-card group overflow-hidden',
    index % 2 ? 'bg-surface-container-lowest' : 'bg-primary-fixed',
  ]}
  data-recipe-card
  data-kashrut={entry.kashrut}
  data-difficulty={entry.difficulty}
  data-minutes={totalMin}
  data-search={searchText}
>
  <div class="relative h-56 overflow-hidden rounded-t-[calc(var(--radius-2xl)-2px)] border-b-2 border-ink bg-surface-container sm:h-60">
    {
      cover && (
        <Picture
          src={cover}
          alt={entry.coverAlt}
          widths={[360, 720, 1080]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          formats={['avif', 'webp']}
          loading={eager ? 'eager' : 'lazy'}
          class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/70 via-transparent to-transparent"></div>

    <Sticker class="absolute start-3.5 top-3.5 z-10">
      <Icon name="material-symbols:timer-outline" class="size-4" aria-hidden="true" />
      {formatMinutes(entry.cookMinutes)} בישול
    </Sticker>

    {/* Favorite toggle: state is handled by src/scripts/favorites.ts (aria-pressed) */}
    <button
      type="button"
      data-fav={slug}
      aria-pressed="false"
      aria-label={`שמירת ${entry.title} למועדפים`}
      class="group/fav absolute end-3.5 top-3.5 z-20 flex size-11 items-center justify-center rounded-full border-2 border-ink bg-surface-container-lowest text-on-surface shadow-soft transition active:scale-90 aria-pressed:bg-secondary aria-pressed:text-on-secondary"
    >
      <Icon name="material-symbols:local-fire-department-outline" class="size-6 group-aria-pressed/fav:hidden" aria-hidden="true" />
      <Icon name="material-symbols:local-fire-department" class="hidden size-6 group-aria-pressed/fav:block" aria-hidden="true" />
    </button>

    <div class="absolute inset-x-3 bottom-3 flex items-center justify-between">
      <KashrutBadge kashrut={entry.kashrut} />
      <HeatBadge difficulty={entry.difficulty} />
    </div>
  </div>

  <div class="flex flex-col gap-2.5 p-4">
    <h3 class="text-2xl leading-tight">
      {/* The ::after stretches this link over the whole card */}
      <a href={`/recipes/${slug}/`} class="after:absolute after:inset-0 after:z-10">{entry.title}</a>
    </h3>
    <p class="line-clamp-2 text-label-lg font-normal leading-relaxed text-on-surface-variant">{entry.summary}</p>
    <div class="flex items-center justify-between border-t-2 border-dashed border-ink/40 pt-3 text-label-md text-on-surface">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1">
          <Icon name="material-symbols:timer-outline" class="size-[18px] text-primary" aria-hidden="true" />
          {formatMinutes(totalMin)}
        </span>
        <span class="flex items-center gap-1">
          <Icon name="material-symbols:bakery-dining-outline" class="size-[18px] text-tertiary" aria-hidden="true" />
          {entry.servings} מנות
        </span>
      </div>
      <Button size="sm" variant="primary" class="pointer-events-none" tabindex="-1" aria-hidden="true">
        למתכון המלא
        {/* arrow-back points left, i.e. "forward" in RTL */}
        <Icon name="material-symbols:arrow-back" class="size-3.5" aria-hidden="true" />
      </Button>
    </div>
  </div>
</TiltCard>
