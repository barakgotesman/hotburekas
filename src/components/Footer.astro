---
import LogoMark from './LogoMark.astro';
import Container from './Container.astro';

interface Props {
  siteTitle: string;
  footerText?: string;
}
const { siteTitle, footerText } = Astro.props;
---

<footer class="mt-16 border-t-2 border-ink bg-inverse-surface pb-28 pt-10 text-center text-inverse-on-surface lg:pb-10" data-print-hide>
  <Container>
    <LogoMark class="mx-auto mb-2 size-12" />
    <p class="font-display text-2xl text-primary-container">{footerText}</p>
    <p class="mt-1 text-label-sm">
      {siteTitle} •
      <a href="/submit/" class="underline underline-offset-2">שליחת מתכון</a> •
      <a href="/rss.xml" class="underline underline-offset-2">RSS</a>
    </p>
  </Container>
</footer>
